# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# -------------------------------------------------------
# Firebase & Secrets — NEVER commit real credentials
# -------------------------------------------------------

# Firebase config generated by flutterfire configure
# Contains real API keys — each developer runs flutterfire configure locally
lib/firebase_options.dart

# Android Firebase config (generated by flutterfire configure)
android/app/google-services.json

# iOS/macOS Firebase config (generated by flutterfire configure)
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# Firebase CLI files
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# -------------------------------------------------------
# Environment & local config
# -------------------------------------------------------

# Local environment variables / secrets
.env
.env.*
*.env
secrets.dart
secrets.json

# Android signing keys — never commit keystores or key configs
android/key.properties
**/*.keystore
**/*.jks

# -------------------------------------------------------
# Generated & build artifacts
# -------------------------------------------------------

# Dart generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# Flutter build cache
.flutter-plugins
/android/.gradle/
/android/build/

# macOS
*.xcworkspace/xcuserdata/
